+float UDigitalAvatarBridge::SpeechEnvAt(float T) const
+{
+	if (SpeechEnv.Num() == 0 || T < 0.f) return 0.f;
+	const float F = T * 100.f; const int32 I = (int32)F;
+	if (I >= SpeechEnv.Num() - 1) return I < SpeechEnv.Num() ? SpeechEnv[I] : 0.f;
+	return FMath::Lerp(SpeechEnv[I], SpeechEnv[I + 1], F - I);
+}
